# Copy to .env and fill in. Never commit .env. (AGENTS.md "Configuration and secrets")

# --- Model (set ONE of these) ------------------------------------------------

# Gemini: the agents run on the OpenAI Agents SDK against Gemini's OpenAI-compatible endpoint.
GEMINI_API_KEY=
# Or OpenAI:
# OPENAI_API_KEY=

# Model name for the agents. Defaults to gemini-flash-lite-latest when GEMINI_API_KEY is set,
# otherwise the OpenAI Agents SDK default.
# AK_AGENT_MODEL=gemini-flash-lite-latest

# --- Telegram (required) ---------------------------------------------------------

# Bot credentials from @BotFather. The "__" is Agent Kernel's nested-key delimiter ->
# config.telegram.bot_token / .webhook_secret
AK_TELEGRAM__BOT_TOKEN=
AK_TELEGRAM__WEBHOOK_SECRET=

# --- Optional ------------------------------------------------------------------

# Weather API key. The competition build's get_weather reads the persisted
# data/weather_<site>.csv the simulator writes, so no key is needed locally; set this only if
# you point get_weather at a live provider.
WEATHER_API_KEY=
